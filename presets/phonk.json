{
  "id": "phonk",
  "name": "Phonk",
  "description": "Aggressive: beat-locked cuts, shake and flashes on bass hits, slow-mo ramp into the payoff on the drop, serif title flash.",
  "default_aspect": "9:16",
  "default_intensity": "med",
  "pacing": {
    "build_cut_beats_start": 2,
    "build_cut_beats_end": 1,
    "final_bar_cut_beats": 0.5,
    "post_cut_beats": 4,
    "post_cut_beats_min": 2,
    "peak_position_in_cut": 0.7,
    "visual_lead": 1.0,
    "visual_tail": 0.35,
    "visual_hero_lead": 1.2,
    "visual_hero_tail": 1.0
  },
  "speed_ramp": {
    "hero": true,
    "slow_rate": 0.4,
    "pre_ramp": 0.35,
    "ease": 0.18,
    "hold_after": 0.25,
    "hero_pre": 0.8,
    "hero_post": 1.2
  },
  "effects": {
    "shake": {
      "on": "bass_hit",
      "duration_ms": {"low": 120, "med": 180, "high": 250},
      "amplitude": {"low": 0.012, "med": 0.022, "high": 0.035},
      "rotation_deg": {"low": 0.4, "med": 0.8, "high": 1.3}
    },
    "flash": {
      "on": "drop,bass_hit_every_2",
      "frames": {"low": 2, "med": 3, "high": 4}
    },
    "chromatic": {
      "on": "with_flash",
      "px": {"low": 2, "med": 4, "high": 6},
      "frames": 3
    },
    "zoom_punch": {
      "on": "downbeat",
      "scale": {"low": 1.05, "med": 1.08, "high": 1.12},
      "ease_ms": 200
    },
    "glitch": {
      "on": "drop",
      "frames": {"low": 0, "med": 2, "high": 3}
    },
    "visual_peak": ["shake", "flash", "zoom_punch"]
  },
  "overlays": {
    "grain": 0.07,
    "vignette": 0.25,
    "letterbox": false,
    "chromatic_static": 0.0
  },
  "grade": {
    "lut": "phonk.cube",
    "lut_strength": 1.0,
    "contrast": 1.12,
    "saturation": 0.88,
    "lift": -0.03,
    "gamma": 0.96
  },
  "text": {
    "font": "Cinzel-Bold.ttf",
    "size_frac": 0.075,
    "letter_spacing": 0.16,
    "color": "#FFFFFF",
    "stroke_px": 0,
    "shadow": 0.6,
    "animation": "flash_in",
    "hold": 0.9,
    "shake": true,
    "position": [0.5, 0.5],
    "flash_with_title": true
  },
  "transitions": {
    "between_sections": "cut",
    "fade_in": 0.0,
    "fade_out": 0.4
  }
}
