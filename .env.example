# Required: Claude (vision tagging, titles, Director chat, search expansion)
ANTHROPIC_API_KEY=
# Only needed for user-scoped keys (sk-ant-usr-...); workspace keys (sk-ant-api03-...) can leave it blank
ANTHROPIC_WORKSPACE_ID=
# Optional: stock footage. Stock search is disabled with a clear message if either is missing.
PEXELS_API_KEY=
PIXABAY_API_KEY=

CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_BUDGET_PER_PROJECT_USD=1.50

DATA_DIR=./data
INBOX_DIR=./inbox
EXPORTS_DIR=./exports

# API/worker/frontend ports
API_PORT=8787
FRONTEND_PORT=5173
